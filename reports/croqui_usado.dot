                <td bgcolor="#ff0000"><font color="white">100% (8/8)&nbsp;&nbsp;</font></td>
                <td port="nome" bgcolor="#3a00c4"><font color="white">22% (8/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Características do grupo, acesso, etc.">descricao&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (4/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#2e00d0"><font color="white">18% (4/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (8/8)&nbsp;&nbsp;</font></td>
