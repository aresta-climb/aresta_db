                <td port="checksum_sha256" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
        </table>
    >];

    "aresta.Croqui":"botoes":e -> "aresta.Botao":w;
    "aresta.Croqui":"picos":e -> "aresta.Pico":w;
