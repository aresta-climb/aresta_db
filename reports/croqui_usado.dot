            </tr>
            <tr>
                <td align="left" tooltip="Coordenada do estacionamento.">localizacao_estacionamento&nbsp;&nbsp;</td>
                <td bgcolor="#cccccc"><font color="black">0% (0/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#cccccc"><font color="black">0% (0/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#1f00df"><font color="white">12% (1/8)&nbsp;&nbsp;</font></td>
                <td port="localizacao_estacionamento" bgcolor="#0700f7"><font color="white">2% (1/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Coordenada da escalada do setor.">localizacao_escalada&nbsp;&nbsp;</td>
                <td bgcolor="#cccccc"><font color="black">0% (0/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#cccccc"><font color="black">0% (0/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#1f00df"><font color="white">12% (1/8)&nbsp;&nbsp;</font></td>
                <td port="localizacao_escalada" bgcolor="#0700f7"><font color="white">2% (1/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Mapas do grupo para detalhar os setores (geralmente mapas de acesso ou visão geral).">mapas&nbsp;&nbsp;</td>
                <td bgcolor="#bf003f"><font color="white">75% (3/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#2200dc"><font color="white">13% (3/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#bf003f"><font color="white">75% (6/8)&nbsp;&nbsp;</font></td>
                <td port="mapas" bgcolor="#2b00d3"><font color="white">17% (6/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Setores que compõem este grupo.">setores&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (4/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#2e00d0"><font color="white">18% (4/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (8/8)&nbsp;&nbsp;</font></td>
                <td port="setores" bgcolor="#3a00c4"><font color="white">22% (8/35)&nbsp;&nbsp;</font></td>
            </tr>
        </table>
    >];

    "aresta.ArquivoExterno" [label=<
        <table border="0" cellborder="1" cellspacing="0">
