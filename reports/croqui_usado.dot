            <tr><td><b>Campo</b>&nbsp;&nbsp;</td><td><b>Relativo Pub.</b>&nbsp;&nbsp;</td><td><b>Em Publicados</b>&nbsp;&nbsp;</td><td><b>Relativo Todos</b>&nbsp;&nbsp;</td><td><b>Em Todos</b>&nbsp;&nbsp;</td></tr>
            <tr>
                <td align="left" tooltip="Nome do grupo (ex: Vale Oculto).">nome&nbsp;&nbsp;</td>
