    "aresta.ArquivoGrupo" [label=<
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td colspan="5" tooltip="Use para referenciar um outro arquivo que contenha informação de grupo caso necessário."><b>ArquivoGrupo</b>&nbsp;&nbsp;</td></tr>
            <tr><td><b>Campo</b>&nbsp;&nbsp;</td><td><b>Relativo Pub.</b>&nbsp;&nbsp;</td><td><b>Em Publicados</b>&nbsp;&nbsp;</td><td><b>Relativo Todos</b>&nbsp;&nbsp;</td><td><b>Em Todos</b>&nbsp;&nbsp;</td></tr>
            <tr>
                <td align="left" tooltip="Representa um grupo de setores (ex: Vale Oculto na Sinuosa, ou conjuntos de blocos de Boulder).">conteudo&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (4/4)&nbsp;&nbsp;</font></td>
                <td bgcolor="#2e00d0"><font color="white">18% (4/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (8/8)&nbsp;&nbsp;</font></td>
                <td port="conteudo" bgcolor="#3a00c4"><font color="white">22% (8/35)&nbsp;&nbsp;</font></td>
            </tr>
        </table>
    >];

    "aresta.Grupo" [label=<
        <table border="0" cellborder="1" cellspacing="0">
