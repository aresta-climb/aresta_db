                <td bgcolor="#ff0000"><font color="white">100% (34/34)&nbsp;&nbsp;</font></td>
                <td port="destino" bgcolor="#f70007"><font color="white">97% (34/35)&nbsp;&nbsp;</font></td>
            </tr>
        </table>
    >];

