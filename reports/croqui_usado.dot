digraph G {
    fontname="Arial";
    rankdir=LR;
    node [shape=none, fontname=Arial];
    labelloc="t";
    labeljust="l";
    label=<
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td colspan="5"><b>Legenda de Colunas</b>&nbsp;&nbsp;</td></tr>
            <tr><td align="left"><b>Relativo Pub.</b>&nbsp;&nbsp;</td><td colspan="4" align="left">Dentre os croquis publicados que criaram esta mensagem, quantos preencheram o campo.&nbsp;&nbsp;&nbsp;&nbsp;</td></tr>
            <tr><td align="left"><b>Em Publicados</b>&nbsp;&nbsp;</td><td colspan="4" align="left">No total de croquis publicados no banco, quantos preencheram o campo.&nbsp;&nbsp;&nbsp;&nbsp;</td></tr>
            <tr><td align="left"><b>Relativo Todos</b>&nbsp;&nbsp;</td><td colspan="4" align="left">Dentre todos os croquis que criaram esta mensagem, quantos preencheram o campo.&nbsp;&nbsp;&nbsp;&nbsp;</td></tr>
            <tr><td align="left"><b>Em Todos</b>&nbsp;&nbsp;</td><td colspan="4" align="left">No total global de croquis no banco, quantos preencheram o campo.&nbsp;&nbsp;&nbsp;&nbsp;</td></tr>
        </table>
    >;

    "aresta.Croqui" [label=<
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td colspan="5" tooltip="Representa um croqui de escalada, que pode incluir um ou mais picos."><b>Croqui</b>&nbsp;&nbsp;</td></tr>
            <tr><td><b>Campo</b>&nbsp;&nbsp;</td><td><b>Relativo Pub.</b>&nbsp;&nbsp;</td><td><b>Em Publicados</b>&nbsp;&nbsp;</td><td><b>Relativo Todos</b>&nbsp;&nbsp;</td><td><b>Em Todos</b>&nbsp;&nbsp;</td></tr>
            <tr>
                <td align="left" tooltip="Identificador único do croqui. Ideal formato como &quot;br_mg_igarape_pedra_grande&quot;.">id&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
                <td port="id" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Nome oficial do croqui.">nome&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
                <td port="nome" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Descrição curta do pico do croqui, que será exibida na lista de croquis. Máximo recomendado de 100 palavras.">descricao&nbsp;&nbsp;</td>
                <td bgcolor="#a2005c"><font color="white">63% (14/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#a2005c"><font color="white">63% (14/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#a70057"><font color="white">65% (23/35)&nbsp;&nbsp;</font></td>
                <td port="descricao" bgcolor="#a70057"><font color="white">65% (23/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Créditos ao criador do croqui.">creditos&nbsp;&nbsp;</td>
                <td bgcolor="#b90045"><font color="white">72% (16/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#b90045"><font color="white">72% (16/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#a0005e"><font color="white">62% (22/35)&nbsp;&nbsp;</font></td>
                <td port="creditos" bgcolor="#a0005e"><font color="white">62% (22/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Botões que aparecem no croqui para mostrarem mais informações.">botoes&nbsp;&nbsp;</td>
                <td bgcolor="#f3000b"><font color="white">95% (21/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#f3000b"><font color="white">95% (21/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#f70007"><font color="white">97% (34/35)&nbsp;&nbsp;</font></td>
                <td port="botoes" bgcolor="#f70007"><font color="white">97% (34/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Picos que fazem parte desse croqui.">picos&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
                <td port="picos" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Repositório interno de arquivos externos que não estão incluídos no .binarypb.">arquivos_externos&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
                <td port="arquivos_externos" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Caminho para a thumbnail do croqui (imagem em miniatura para prever croquis não baixados). Essa imagem deve ter no máximo 1200x1200.">caminho_thumbnail&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#f70007"><font color="white">97% (34/35)&nbsp;&nbsp;</font></td>
                <td port="caminho_thumbnail" bgcolor="#f70007"><font color="white">97% (34/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Representa se o croqui já foi revisado manualmente para garantir qualidade.">revisado_manualmente&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#a70057"><font color="white">65% (23/35)&nbsp;&nbsp;</font></td>
                <td port="revisado_manualmente" bgcolor="#a70057"><font color="white">65% (23/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Representa se o croqui já foi revisado para ter bounding circles apropriados.">revisado_bounding_circle&nbsp;&nbsp;</td>
                <td bgcolor="#2200dc"><font color="white">13% (3/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#2200dc"><font color="white">13% (3/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#1d00e1"><font color="white">11% (4/35)&nbsp;&nbsp;</font></td>
                <td port="revisado_bounding_circle" bgcolor="#1d00e1"><font color="white">11% (4/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Representa se o croqui tem desenhos extraíveis do PDF. Isso indica se as linhas do croqui podem ser extraídas do PDF como desenho vetorial, o que resulta em extrações de PDF de mais alta qualidade.">status_desenho_extraivel&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#e90015"><font color="white">91% (32/35)&nbsp;&nbsp;</font></td>
                <td port="status_desenho_extraivel" bgcolor="#e90015"><font color="white">91% (32/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Identificador da última migração aplicada a este croqui (prefixo numérico sequencial).">ultima_migracao&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
                <td port="ultima_migracao" bgcolor="#ff0000"><font color="white">100% (35/35)&nbsp;&nbsp;</font></td>
            </tr>
            <tr>
                <td align="left" tooltip="Define se o croqui está publicado no índice principal para os usuários do aplicativo. Se false (padrão do proto3), ele funcionará apenas como rascunho.">publicar_croqui&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#ff0000"><font color="white">100% (22/22)&nbsp;&nbsp;</font></td>
                <td bgcolor="#a0005e"><font color="white">62% (22/35)&nbsp;&nbsp;</font></td>
                <td port="publicar_croqui" bgcolor="#a0005e"><font color="white">62% (22/35)&nbsp;&nbsp;</font></td>
            </tr>
        </table>
    >];

    "aresta.Botao" [label=<
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td colspan="5" tooltip="Representa um botão que leva a alguma outra parte do croqui."><b>Botao</b>&nbsp;&nbsp;</td></tr>
            <tr><td><b>Campo</b>&nbsp;&nbsp;</td><td><b>Relativo Pub.</b>&nbsp;&nbsp;</td><td><b>Em Publicados</b>&nbsp;&nbsp;</td><td><b>Relativo Todos</b>&nbsp;&nbsp;</td><td><b>Em Todos</b>&nbsp;&nbsp;</td></tr>
            <tr>
                <td align="left" tooltip="Texto que aparecerá no botão.">texto&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (21/21)&nbsp;&nbsp;</font></td>
