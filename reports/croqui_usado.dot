    "aresta.ViaMultiplasEnfiadas":"mapas":e -> "aresta.Mapa":w;
    "aresta.ViaMultiplasEnfiadas":"enfiadas":e -> "aresta.Escalada":w;
    "aresta.ArquivoGrupo":"conteudo":e -> "aresta.Grupo":w;
    "aresta.Grupo":"localizacao_estacionamento":e -> "aresta.Coordenada":w;
    "aresta.Grupo":"localizacao_escalada":e -> "aresta.Coordenada":w;
    "aresta.Grupo":"mapas":e -> "aresta.Mapa":w;
    "aresta.Grupo":"setores":e -> "aresta.ArquivoSetor":w;
