            </tr>
            <tr>
                <td align="left" tooltip="Representa o que será mostrado caso o botão for clicado.">destino&nbsp;&nbsp;</td>
                <td bgcolor="#ff0000"><font color="white">100% (21/21)&nbsp;&nbsp;</font></td>
